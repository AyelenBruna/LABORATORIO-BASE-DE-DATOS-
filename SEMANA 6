# LABORATORIO-BASE-DE-DATOS-
CREATE DATABASE ALQUILER
USE ALQUILER

CREATE TABLE cliente (
    id_cliente CHAR(5) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    dni INT UNIQUE NOT NULL
);

CREATE TABLE carro (
    id_auto CHAR(5) PRIMARY KEY,
    marca VARCHAR(50) NOT NULL,
    precio DECIMAL(10,2) NOT NULL,
    anio INT NOT NULL
);

CREATE TABLE comprobante (
    id_comprobante CHAR(5) PRIMARY KEY,
    id_cliente CHAR(5) NOT NULL,
    id_auto CHAR(5) NOT NULL,
    fecha DATE NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),
    FOREIGN KEY (id_auto) REFERENCES carro(id_auto)
);

