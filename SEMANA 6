SELECT co.id_comprobante, ca.marca
FROM comprobante co
JOIN carro ca 
ON co.id_auto = ca.id_auto;

SELECT c.nombre, co.fecha
FROM cliente c
JOIN comprobante co 
ON c.id_cliente = co.id_cliente;

